<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Inventario" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="dd84413d-598f-4cca-81a6-b61bc118bb88">
<property name="ireport.zoom" value="1.0"/>
<property name="ireport.x" value="0"/>
<property name="ireport.y" value="0"/>
<parameter name="P_USUARIO" class="java.lang.String"/><parameter name="P_FILTROS" class="java.lang.String"/><parameter name="P_LOGO" class="java.awt.Image"/><parameter name="P_CATEGORIA" class="java.lang.Integer"/><parameter name="P_ESTADO" class="java.lang.String"/>
<queryString><![CDATA[SELECT ej.codigo_inventario, l.titulo, CONCAT(a.nombres, ' ', a.apellidos) AS autor,
       c.nombre AS categoria, ej.ubicacion, ej.estado,
       CASE ej.estado WHEN 'DISPONIBLE' THEN 'Disponible' WHEN 'PRESTADO' THEN 'Prestado'
                      WHEN 'DANADO' THEN 'Dañado' ELSE 'Perdido' END AS estado_texto
FROM ejemplares ej
JOIN libros l ON l.id_libro = ej.id_libro
JOIN autores a ON a.id_autor = l.id_autor
JOIN categorias c ON c.id_categoria = l.id_categoria
WHERE ($P{P_CATEGORIA} IS NULL OR c.id_categoria = $P{P_CATEGORIA})
  AND ($P{P_ESTADO} IS NULL OR ej.estado = $P{P_ESTADO})
ORDER BY c.nombre, l.titulo, ej.codigo_inventario]]></queryString>
<field name="codigo_inventario" class="java.lang.String"/><field name="titulo" class="java.lang.String"/><field name="autor" class="java.lang.String"/><field name="categoria" class="java.lang.String"/><field name="ubicacion" class="java.lang.String"/><field name="estado" class="java.lang.String"/><field name="estado_texto" class="java.lang.String"/>
<variable name="V_DISPONIBLES" class="java.lang.Integer" calculation="Sum"><variableExpression><![CDATA[Integer.valueOf("DISPONIBLE".equals($F{estado}) ? 1 : 0)]]></variableExpression></variable><variable name="V_PRESTADOS" class="java.lang.Integer" calculation="Sum"><variableExpression><![CDATA[Integer.valueOf("PRESTADO".equals($F{estado}) ? 1 : 0)]]></variableExpression></variable><variable name="V_DANADOS" class="java.lang.Integer" calculation="Sum"><variableExpression><![CDATA[Integer.valueOf("DANADO".equals($F{estado}) ? 1 : 0)]]></variableExpression></variable><variable name="V_PERDIDOS" class="java.lang.Integer" calculation="Sum"><variableExpression><![CDATA[Integer.valueOf("PERDIDO".equals($F{estado}) ? 1 : 0)]]></variableExpression></variable>
<group name="grupo"><groupExpression><![CDATA[$F{categoria}]]></groupExpression><groupHeader><band height="24"><textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement x="0" y="4" width="802" height="18" uuid="d6d58b84-85b3-41cb-8790-df13d6a1ad52" forecolor="#007A7A"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="10" isBold="true"/></textElement><textFieldExpression><![CDATA["Categoría: " + $F{categoria}]]></textFieldExpression></textField></band></groupHeader><groupFooter><band height="20"><line><reportElement x="0" y="2" width="802" height="1" uuid="a4e9b5a5-10af-439b-af17-433732455a47" forecolor="#C8D2D7"/></line><textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement x="0" y="3" width="802" height="16" uuid="49b80bef-4803-46c3-88ce-a95b6dc6bb81" forecolor="#5A6973"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="false"/></textElement><textFieldExpression><![CDATA["Ejemplares en la categoría: " + $V{grupo_COUNT}]]></textFieldExpression></textField></band></groupFooter></group>
<title><band height="86"><rectangle><reportElement x="0" y="0" width="802" height="60" uuid="0b0878ea-a192-4fb5-93ca-a9fbd81208a0" mode="Opaque" backcolor="#009999" forecolor="#009999"/><graphicElement><pen lineWidth="0.0"/></graphicElement></rectangle><rectangle><reportElement x="8" y="6" width="48" height="48" uuid="28e68d0b-e570-436f-bf8f-a5cc2ca23d75" mode="Opaque" backcolor="#FFFFFF" forecolor="#FFFFFF"/><graphicElement><pen lineWidth="0.0"/></graphicElement></rectangle><image scaleImage="RetainShape" hAlign="Center" vAlign="Middle" onErrorType="Blank"><reportElement x="10" y="8" width="44" height="44" uuid="a3fb7394-9411-4a5f-a989-47be51f1b393"/><imageExpression><![CDATA[$P{P_LOGO}]]></imageExpression></image><staticText><reportElement x="66" y="6" width="470" height="26" uuid="ed0248cd-6dd9-4242-b565-34a2bb1ab801" forecolor="#FFFFFF"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="17" isBold="true"/></textElement><text><![CDATA[BIBLIOTECA DIGITAL FISEI]]></text></staticText><staticText><reportElement x="66" y="32" width="470" height="22" uuid="4eb9352e-f073-45f9-815b-0c66a5d5798d" forecolor="#FFFFFF"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="11" isBold="false"/></textElement><text><![CDATA[INVENTARIO DE EJEMPLARES]]></text></staticText><textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement x="540" y="8" width="254" height="16" uuid="8c2da2b6-770a-4eac-92b1-7dd03cbdb67d" forecolor="#FFFFFF"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="false"/></textElement><textFieldExpression><![CDATA["Generado: " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement x="540" y="26" width="254" height="16" uuid="a183406b-fce4-4b73-afef-55e7b9ecdbd1" forecolor="#FFFFFF"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="false"/></textElement><textFieldExpression><![CDATA["Por: " + ($P{P_USUARIO} == null ? "—" : $P{P_USUARIO})]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement x="0" y="66" width="802" height="16" uuid="ba815dbd-1085-4ca6-bc70-39db619a7a97" forecolor="#5A6973"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="false"/></textElement><textFieldExpression><![CDATA["Filtros: " + ($P{P_FILTROS} == null || $P{P_FILTROS}.isEmpty() ? "ninguno" : $P{P_FILTROS})]]></textFieldExpression></textField></band></title>
<columnHeader><band height="22"><rectangle><reportElement x="0" y="0" width="802" height="22" uuid="e7a26100-cacd-4f12-8487-6cdbb3d87786" mode="Opaque" backcolor="#E3F1F1" forecolor="#E3F1F1"/><graphicElement><pen lineWidth="0.0"/></graphicElement></rectangle><staticText><reportElement x="0" y="0" width="90" height="22" uuid="507fb4e0-ea06-40dc-a0f5-b0e97812542c" forecolor="#007A7A"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement><text><![CDATA[Código]]></text></staticText><staticText><reportElement x="90" y="0" width="290" height="22" uuid="73bac0e6-caf9-4d92-bf47-d84b4cc4f0aa" forecolor="#007A7A"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement><text><![CDATA[Título]]></text></staticText><staticText><reportElement x="380" y="0" width="200" height="22" uuid="bcc74ed0-c480-448e-bcd1-5b1c4118c1ae" forecolor="#007A7A"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement><text><![CDATA[Autor]]></text></staticText><staticText><reportElement x="580" y="0" width="120" height="22" uuid="4356dd25-100d-4822-98a1-23abad0938f2" forecolor="#007A7A"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement><text><![CDATA[Ubicación]]></text></staticText><staticText><reportElement x="700" y="0" width="102" height="22" uuid="b1d8ce2c-4f9b-4a2c-b169-5834e9a1fa38" forecolor="#007A7A"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement><text><![CDATA[Estado]]></text></staticText><line><reportElement x="0" y="21" width="802" h