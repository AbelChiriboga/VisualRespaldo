<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Historial" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="0bd94986-dd21-418d-8a1c-eab6972cd68c">
<property name="ireport.zoom" value="1.0"/>
<property name="ireport.x" value="0"/>
<property name="ireport.y" value="0"/>
<parameter name="P_USUARIO" class="java.lang.String"/><parameter name="P_FILTROS" class="java.lang.String"/><parameter name="P_LOGO" class="java.awt.Image"/><parameter name="P_DESDE" class="java.util.Date"/><parameter name="P_HASTA" class="java.util.Date"/><parameter name="P_CARRERA" class="java.lang.Integer"/><parameter name="P_ESTADO" class="java.lang.String"/>
<queryString><![CDATA[SELECT p.fecha_prestamo, e.cedula, CONCAT(e.nombres, ' ', e.apellidos) AS estudiante, ca.nombre AS carrera,
       l.titulo, ej.codigo_inventario, p.fecha_limite, p.fecha_devolucion, p.estado,
       CASE p.estado WHEN 'ACTIVO' THEN 'Activo' ELSE 'Devuelto' END AS estado_texto,
       IFNULL(m.monto, 0) AS multa
FROM prestamos p
JOIN estudiantes e ON e.id_estudiante = p.id_estudiante
JOIN carreras ca ON ca.id_carrera = e.id_carrera
JOIN ejemplares ej ON ej.id_ejemplar = p.id_ejemplar
JOIN libros l ON l.id_libro = ej.id_libro
LEFT JOIN multas m ON m.id_prestamo = p.id_prestamo
WHERE DATE(p.fecha_prestamo) BETWEEN DATE($P{P_DESDE}) AND DATE($P{P_HASTA})
  AND ($P{P_CARRERA} IS NULL OR ca.id_carrera = $P{P_CARRERA})
  AND ($P{P_ESTADO} IS NULL OR p.estado = $P{P_ESTADO})
ORDER BY p.fecha_prestamo DESC]]></queryString>
<field name="fecha_prestamo" class="java.sql.Timestamp"/><field name="cedula" class="java.lang.String"/><field name="estudiante" class="java.lang.String"/><field name="carrera" class="java.lang.String"/><field name="titulo" class="java.lang.String"/><field name="codigo_inventario" class="java.lang.String"/><field name="fecha_limite" class="java.sql.Timestamp"/><field name="fecha_devolucion" class="java.sql.Timestamp"/><field name="estado" class="java.lang.String"/><field name="estado_texto" class="java.lang.String"/><field name="multa" class="java.math.BigDecimal"/>
<variable name="V_ACTIVOS" class="java.lang.Integer" calculation="Sum"><variableExpression><![CDATA[Integer.valueOf("ACTIVO".equals($F{estado}) ? 1 : 0)]]></variableExpression></variable><variable name="V_DEVUELTOS" class="java.lang.Integer" calculation="Sum"><variableExpression><![CDATA[Integer.valueOf("DEVUELTO".equals($F{estado}) ? 1 : 0)]]></variableExpression></variable><variable name="V_MULTAS" class="java.math.BigDecimal" calculation="Sum"><variableExpression><![CDATA[$F{multa}]]></variableExpression></variable>

